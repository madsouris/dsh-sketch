{
  "name": "@local/dsh-sketch",
  "version": "1.0.0",
  "private": true,
  "description": "Design in the Sketch desktop app through its local MCP server, with Sketch skills and stack/symbol guardrails for the agent",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madsouris/dsh-sketch.git"
  },
  "homepage": "https://github.com/madsouris/dsh-sketch#readme",
  "bugs": {
    "url": "https://github.com/madsouris/dsh-sketch/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "sketch",
    "mcp",
    "design"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "skills/**",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
